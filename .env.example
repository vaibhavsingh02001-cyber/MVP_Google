# ============================================================
# Recall MVP — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ── Backend ──────────────────────────────────────────────────
# Anthropic API key — used by the agent at runtime
ANTHROPIC_API_KEY=sk-ant-...

# Vision API key — only needed when running pipeline/tag_images.py
# Leave blank if using Claude vision for tagging (recommended)
VISION_API_KEY=

# User upload limits
MAX_UPLOAD_MB=10
UPLOAD_TTL_HOURS=24

# ChromaDB persistence directory (relative to backend/)
CHROMA_PERSIST_DIR=./storage/chroma

# Token to protect the /session/export endpoint (set any secret string)
EXPORT_TOKEN=change-me-before-deploy

# ── Frontend ─────────────────────────────────────────────────
# URL of the running backend API
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Pipeline (build-time only) ────────────────────────────────
# Unsplash API key — used by pipeline/download_images.py
UNSPLASH_KEY=your-unsplash-access-key
